<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="default">
        <class>com.tulisko.clinicmangaer.model.User</class>
        <class>com.tulisko.clinicmangaer.model.Admin</class>
        <class>com.tulisko.clinicmangaer.model.Patient</class>
        <class>com.tulisko.clinicmangaer.model.Doctor</class>
        <class>com.tulisko.clinicmangaer.model.Staff</class>
        <class>com.tulisko.clinicmangaer.model.Department</class>
        <class>com.tulisko.clinicmangaer.model.Specialty</class>
        <class>com.tulisko.clinicmangaer.model.Availability</class>
        <class>com.tulisko.clinicmangaer.model.Absence</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5434/clinic_db"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="12345678"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
